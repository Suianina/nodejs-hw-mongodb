<!DOCTYPE html>
<html>
  <head>
    <title>Reset Password</title>
  </head>
  <body>
    <h1>Reset your password</h1>
    <form action="/auth/reset-pwd" method="POST">
      <input type="hidden" name="token" value="<%= token %>" />
      <input
        type="password"
        name="password"
        placeholder="Enter new password"
        required
      />
      <button type="submit">Submit</button>
    </form>
  </body>
</html>
